# Copy this file to backend/.env and fill in the values. The server reads it
# at startup (see app/config.py). Never commit the real .env (it is ignored).

# --- Supabase: keep results after a restart/redeploy (optional) ---
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# service_role secret key (NOT the anon/public key): Project Settings -> API
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Password-protect the app when it is reachable from the internet (optional) ---
# APP_PASSWORD=change-me
# APP_USERNAME=myteam

# --- Limits (optional) ---
# MAX_UPLOAD_MB=1024
# MAX_FRAMES=3000
# MAX_FRAME_SIDE=720
# RESULTS_MAX_MB=500
